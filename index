        // Apply Filters Logic
        function getFilteredItems() {
            const search = document.getElementById('search-input').value.toLowerCase();
            const abcxyz = document.getElementById('filter-abcxyz').value;
            const urgency = document.getElementById('filter-urgency').value;
            const supplier = document.getElementById('filter-supplier').value;

            return state.items.filter(item => {
                const matchesSearch = item.name.toLowerCase().includes(search) || item.sku.toLowerCase().includes(search) || item.supplier.toLowerCase().includes(search);
                const matchesAbc = abcxyz === 'ALL' || item.abcxyz === abcxyz;
                const matchesUrgency = urgency === 'ALL' || item.urgency === urgency;
                const matchesSupplier = supplier === 'ALL' || item.supplier === supplier;
                const matchesMatrix = !state.activeMatrixFilter || item.abcxyz === state.activeMatrixFilter;

                return matchesSearch && matchesAbc && matchesUrgency && matchesSupplier && matchesMatrix;
            });
        }

        function applyFilters() {
            renderTable();
        }

        // Filter by Matrix Cell Click
        function filterByMatrix(segment) {
            if (state.activeMatrixFilter === segment) {
                state.activeMatrixFilter = null; // Toggle off
            } else {
                state.activeMatrixFilter = segment;
            }

            // Update Active Matrix Visual States
            document.querySelectorAll('.matrix-cell').forEach(cell => cell.classList.remove('active'));
            if (state.activeMatrixFilter) {
                const activeCell = document.getElementById(`cell-${state.activeMatrixFilter}`);
                if (activeCell) activeCell.classList.add('active');
                document.getElementById('active-filter-tag').innerText = `Сегмент: ${state.activeMatrixFilter}`;
                document.getElementById('active-filter-tag').classList.remove('hidden');
            } else {
                document.getElementById('active-filter-tag').classList.add('hidden');
            }

            renderTable();
        }

        function resetMatrixFilter() {
            state.activeMatrixFilter = null;
            document.querySelectorAll('.matrix-cell').forEach(cell => cell.classList.remove('active'));
            document.getElementById('active-filter-tag').classList.add('hidden');
            renderTable();
        }

