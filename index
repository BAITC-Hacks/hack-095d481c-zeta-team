            document.getElementById('filter-supplier').value = 'ALL';
            resetMatrixFilter();
        }

        // Update Matrix Item Counters
        function updateMatrixCounts() {
            const counts = { AX:0, AY:0, AZ:0, BX:0, BY:0, BZ:0, CX:0, CY:0, CZ:0 };
            state.items.forEach(item => {
                if (counts[item.abcxyz] !== undefined) {
                    counts[item.abcxyz]++;
                }
            });

            for (const key in counts) {
                const el = document.getElementById(`count-${key}`);
                if (el) el.innerText = counts[key];
            }
        }

        // KPI Calculations
        function updateKPIs() {
            const totalSum = state.items.reduce((acc, item) => acc + (item.recommendedQty * item.price), 0);
            const totalItems = state.items.length;
            const stockoutRiskCount = state.items.filter(item => item.urgency === 'CRITICAL').length;
            const axCount = state.items.filter(item => item.abcxyz.startsWith('A')).length;
            const axShare = totalItems > 0 ? ((axCount / totalItems) * 100).toFixed(1) : 0;
            const selectedCount = state.items.filter(i => i.selected).length;

            document.getElementById('kpi-total-sum').innerText = formatKZT(totalSum);
            document.getElementById('kpi-total-items').innerText = `${totalItems} SKU`;
            document.getElementById('kpi-stockout-risk').innerText = `${stockoutRiskCount} SKU`;
            document.getElementById('kpi-ax-share').innerText = `${axShare}%`;
            document.getElementById('kpi-selected-count').innerText = selectedCount;
        }

