            let csvContent = "data:text/csv;charset=utf-8,Артикул;Наименование;Поставщик;Класс;Заказ;Цена;Сумма\n";
            selectedItems.forEach(i => {
                csvContent += `${i.sku};"${i.name}";${i.supplier};${i.abcxyz};${i.recommendedQty};${i.price};${i.recommendedQty * i.price}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Заказ_Поставщикам_EKT_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function approveOrders() {
            const selected = state.items.filter(i => i.selected);
            if (selected.length === 0) {
                alert("Выберите хотя бы один заказ для утверждения.");
                return;
            }

            const totalSum = selected.reduce((acc, i) => acc + (i.recommendedQty * i.price), 0);
            
            if (confirm(`Утвердить ${selected.length} заказов на общую сумму ${formatKZT(totalSum)}?\nДанные будут переданы в учетную систему 1С.`)) {
                alert("Успешно! Заказы отправлены на формирование в 1С:Управление Торговлей.");
            }
        }

        // Run App Initialization on Load
        window.onload = function() {
            renderApp();
        };
    </script>
</body>
</html>
