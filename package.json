{
  "name": "procureflow",
  "productName": "ProcureFlow",
  "version": "0.2.0",
  "private": true,
  "description": "Offline Excel procurement planning for Windows and GitHub Pages",
  "author": "ProcureFlow Team",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "python3 -m http.server 8000",
    "test": "node tests/engine.test.cjs && node tests/project.test.cjs && node tests/desktop.test.cjs",
    "test:desktop": "electron . --smoke-test",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never",
    "check:offline": "node scripts/check-offline.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "kz.procureflow.desktop",
    "productName": "ProcureFlow",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "desktop/**/*.cjs",
      "package.json",
      "LICENSE",
      "docs/DESKTOP.md",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "ProcureFlow",
      "artifactName": "ProcureFlow-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "ProcureFlow-Portable-${version}-${arch}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "ProcureFlow-Setup-${version}-${arch}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProcureFlow",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
